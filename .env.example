# ---------------------------------------------------------------------------
# Copia este archivo a .env y rellena lo que uses. .env está en .gitignore.
# Solo secretos y rutas de máquina: todo lo demás va en config/*.yaml.
# Deja vacía cualquier clave que no necesites; el cargador avisa de las que
# faltan para los proveedores que sí usa una región activa.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Datos de mercado ------------------------------------------------------
# yfinance no necesita clave.
FINNHUB_API_KEY=
FRED_API_KEY=
EODHD_API_KEY=
FMP_API_KEY=

# La SEC exige un User-Agent identificable con nombre y correo. Sin él, 403.
SEC_EDGAR_USER_AGENT="Nombre Apellido correo@ejemplo.com"

# --- Entrega ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Entorno de ejecución --------------------------------------------------
MA_ENV=dev                           # dev | prod
MA_CONFIG_DIR=config
# MA_DATA_DIR=D:/market-data         # si se define, sobreescribe settings.data.dir
MA_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
